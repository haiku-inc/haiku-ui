# GEBCO bathymetry source grids — multi-GB; preprocessed offline into a compact
# asset (scripts/preprocess_gebco.py → public/data/ocean/). Never commit the raw grids.
/docs/ocean/*.zip
/docs/ocean/*.nc

# NASADEM elevation tiles — raw 1°×1° Int16 GeoTIFFs downloaded from
# OpenTopography and their lossless-COG re-encodings (scripts/download_nasadem.py
# → data/nasadem/raw/, scripts/compress_nasadem.py → data/nasadem/cog/).
# Multi-hundred-MB and fully regenerable; never commit (mirrors the GEBCO grids).
/data/nasadem/

# Offline self-hosted basemap — PMTiles vector archives built offline
# (scripts/build-basemap-pmtiles.mjs → public/basemap/{world,ukraine,iran}.pmtiles)
# and shipped in dist/. Regenerable; never commit them (mirrors the GEBCO grids).
# .basemap-tools holds the auto-downloaded go-pmtiles build binary.
/public/basemap/*.pmtiles
/.basemap-tools/
# MapLibre GL basemap glyphs + sprite, provisioned offline (scripts/build-basemap-fonts.mjs
# → public/basemap/fonts/**, public/basemap/sprites/**). Regenerable; shipped in dist/.
/public/basemap/fonts/
/public/basemap/sprites/
/public/data/nasadem

# USSF Astrodynamics Standards delivery (SGP4Prop v9.9 native suite + WASM).
# Acquired via a Space-Track account: US-person / US-Government-purpose use only.
# The suite DLLs (Obs, Vcm, SatState, ...) are NOT covered by the SGP4 open license
# and are almost certainly non-redistributable. NEVER commit this tree — the Phase 3
# desktop FFI loads these binaries from a developer-local `ref/` path at runtime.
/ref/

# Relocated USSF AstroStandards runtime binaries for the Phase 3 desktop FFI.
# Binaries ONLY — US-person-acquired, non-redistributable, provisioned at package
# time (bundled into the installer out-of-band). The tracked README + license stay.
/src-tauri/astrostandards/lib/

# llama.cpp llama-server sidecar binaries for ingest tier 4. GB-scale toolchain output,
# provisioned out-of-band at package time (bundle.externalBin). Never committed — the
# tracked README stays. See docs/INGEST_ENGINE.md.
/src-tauri/binaries/*
!/src-tauri/binaries/README.md

# Ingest engine SQLite stores (desktop app_data_dir and daemon --data-dir defaults).
/src-tauri/data/
*.db-wal
*.db-shm

# onnxruntime shared library for ort load-dynamic (side-loaded, not committed).
/src-tauri/onnxruntime*.dll

# Software bill of materials artifacts, regenerated in CI.
/sbom/
/LLM_WORK
