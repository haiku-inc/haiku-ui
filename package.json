{
  "name": "haiku-ui",
  "private": false,
  "version": "1.0.2",
  "description": "UI elements and styles for Haiku products",
  "repository": {
    "type": "git",
    "url": "git@github.com:haiku-inc/haiku-ui.git"
  },
  "keywords": [
    "ts",
    "haiku",
    "ui",
    "scss",
    "sass",
    "styles"
  ],
  "files": [
    "src",
    "dist"
  ],
  "author": {
    "name": "Kostiantyn Nazarenko",
    "email": "const@nazarenko.es"
  },
  "type": "module",
  "main": "src/index.ts",
  "devDependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@eslint/js": "10.0.1",
    "@mui/icons-material": "9.2.0",
    "@mui/material": "9.2.0",
    "@mui/x-date-pickers": "9.9.0",
    "@tailwindcss/vite": "4.3.2",
    "@toast-ui/editor": "3.2.2",
    "@toast-ui/editor-plugin-chart": "3.0.1",
    "@toast-ui/editor-plugin-code-syntax-highlight": "3.1.0",
    "@toast-ui/editor-plugin-table-merged-cell": "3.1.0",
    "@toast-ui/editor-plugin-uml": "3.0.1",
    "@toast-ui/react-editor": "3.2.3",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "6.0.3",
    "classnames": "2.5.1",
    "dayjs": "1.11.21",
    "eslint": "10.7.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.7.0",
    "husky": "9.1.7",
    "lint-staged": "17.0.8",
    "prettier": "3.9.6",
    "prettier-plugin-organize-imports": "4.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-helmet-async": "3.0.0",
    "react-router-dom": "7.18.1",
    "sass-embedded": "1.100.0",
    "tailwindcss": "4.3.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "8.64.0",
    "vite": "8.1.4",
    "vite-plugin-dts": "5.0.3",
    "vite-plugin-svgr": "5.2.0",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@fontsource/bebas-neue": "5.2.7",
    "@fontsource/cairo": "5.2.7",
    "@fontsource/economica": "5.2.8",
    "@fontsource/inconsolata": "5.2.8",
    "@fontsource/orbitron": "5.2.8",
    "@fontsource/oxanium": "5.2.8",
    "@fontsource/rajdhani": "5.2.7",
    "@fontsource/roboto": "5.2.10",
    "@mui/icons-material": "9.2.0",
    "@mui/material": "9.2.0",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "preview": "vite preview",
    "check-types": "tsc",
    "compile": "tsc -p .",
    "predeploy": "npm run build",
    "prepare": "husky",
    "start": "npm run dev",
    "update-interactive": "npm-check --update --save-exact",
    "lint-staged": "lint-staged",
    "lint:fix": "eslint src --fix",
    "prettier": "prettier --check src/ ./package.json ./README.md",
    "prettier:fix": "prettier --write --ignore-unknown src/ ./package.json ./README.md"
  },
  "engines": {
    "npm": ">=11",
    "node": ">=22"
  }
}
